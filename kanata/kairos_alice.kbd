(defcfg
  process-unmapped-keys yes
)

(defsrc
1    2    3    4    5    6    7    8    9    0    min  =
q    w    e    r    t    y    u    i    o    p    [    ]
a    s    d    f    g    h    j    k    l    ;    '
z    x    c    v    b    n    m    ,    .    /
        spc   Backspace   F14   ControlRight
)

(deflayer base
1    2    3    4    5    6    7    8    9    0    @min1 @eq1
v    l    d    m    g    x    f    o    u    ,    @[1   @]1
s    r    t    y    p    b    n    a    e    i    '
z    q    k    c    w    j    h    .    min  ;
        spc   Backspace   @mag  @util
)

(deflayer util
     S-1   S-2   S-3   S-4   S-5   S-6   S-7   S-8   S-9   S-0   min   =
     +     =     S-9   S-0  Delete XX    S-[   S-]   [     ]     _     _
     1     2     3     4     5     6     7     8     9     0     _
ControlLeft ArrowDown ArrowLeft ArrowRight ArrowUp XX S-, S-. S-4 XX
                             _   C-Backspace   _    _
)

(deflayer qwerty
1    2    3    4    5    6    7    8    9    0    @min2 @eq2
q    w    e    r    t    y    u    i    o    p    @[2   @]2
a    s    d    f    g    h    j    k    l    ;    '
z    x    c    v    b    n    m    ,    .    /
        spc    _       spc    _
)

(defchords qwerty_chord 60
    ([) [
    (]) ]
    ([ ]) @qwerty
)

(defchords base_chord 60
    ([) [
    (]) ]
    ([ ]) @base
)

(defchords no_op1 60
    (qmark) @qmark
    (=) =
    (qmark =) XX
)

(defchords no_op2 60
    (min) min
    (=) =
    (min =) XX
)

(defalias
  oss (one-shot 1000 ShiftRight)

  min1 (chord qwerty_chord [)
  eq1 (chord qwerty_chord ])
  [1 (chord no_op1 qmark)
  ]1 (chord no_op1 =)

  min2 (chord no_op2 min)
  eq2 (chord no_op2 =)
  [2 (chord base_chord [)
  ]2 (chord base_chord ])

  qwerty (layer-switch qwerty)
  base (layer-switch base)

  util (layer-toggle util)

  qmark (fork S-/ (unshift /) (lshft rshft))

  mag (switch
    ((key-timing 1 greater-than 500)) @oss break
  
    ((key-history a 1)) rpt break
    ((key-history b 1)) rpt break
    ((key-history c 1)) rpt break
    ((key-history d 1)) rpt break
    ((key-history e 1)) rpt break
    ((key-history f 1)) rpt break
    ((key-history g 1)) rpt break
    ((key-history h 1)) rpt break
    ((key-history i 1)) rpt break
    ((key-history j 1)) rpt break
    ((key-history k 1)) rpt break
    ((key-history l 1)) rpt break
    ((key-history m 1)) rpt break
    ((key-history n 1)) rpt break
    ((key-history o 1)) rpt break
    ((key-history p 1)) rpt break
    ((key-history q 1)) rpt break
    ((key-history r 1)) rpt break
    ((key-history s 1)) rpt break
    ((key-history t 1)) rpt break
    ((key-history u 1)) e break
    ((key-history v 1)) rpt break
    ((key-history w 1)) rpt break
    ((key-history x 1)) rpt break
    ((key-history y 1)) rpt break
    ((key-history z 1)) rpt break

    () @oss break
  )
)
